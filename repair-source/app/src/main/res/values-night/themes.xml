<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lingo" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lingo_primary</item>
        <item name="colorOnPrimary">@color/lingo_on_primary</item>
        <item name="colorPrimaryContainer">@color/lingo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/lingo_on_primary_container</item>

        <item name="colorSecondary">@color/lingo_secondary</item>
        <item name="colorOnSecondary">@color/lingo_on_secondary</item>

        <item name="android:colorBackground">@color/lingo_bg</item>
        <item name="colorSurface">@color/lingo_surface</item>
        <item name="colorSurfaceVariant">@color/lingo_surface_variant</item>
        <item name="colorOnSurface">@color/lingo_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/lingo_on_surface_variant</item>
        <item name="colorOutline">@color/lingo_outline</item>

        <item name="android:statusBarColor">@color/lingo_bg</item>
        <item name="android:navigationBarColor">@color/lingo_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 12+ sistem açılış ekranı: arka plan girişteki animasyonla aynı renk, geçiş dikişsiz olsun -->
        <item name="android:windowSplashScreenBackground">@color/lingo_bg</item>
        <item name="android:windowBackground">@color/lingo_bg</item>
    </style>
</resources>
