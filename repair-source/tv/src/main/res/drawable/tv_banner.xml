<?xml version="1.0" encoding="utf-8"?>
<!-- TV ana ekranı afişi (320x180): lacivert zemin, ortada GameLingo simgesi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="@color/lingo_bg" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
    <item android:height="4dp" android:gravity="bottom">
        <shape android:shape="rectangle"><solid android:color="@color/lingo_primary" /></shape>
    </item>
</layer-list>
